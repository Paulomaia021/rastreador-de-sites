# Configurações opcionais de envio automático via WhatsApp
# (Cada usuário também pode configurar seu próprio número e chave CallMeBot diretamente na interface web!)

# Número padrão de fallback para uso via terminal (ex: 5521999998888)
DEFAULT_WHATSAPP_PHONE=

# Opção 1: CallMeBot WhatsApp API (100% gratuito para uso pessoal)
WHATSAPP_CALLMEBOT_APIKEY=

# Opção 2: Gateway / Webhook de WhatsApp próprio (Evolution API, Z-API, etc.)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Opção 3: Twilio WhatsApp API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
